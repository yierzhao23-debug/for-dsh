{
  "name": "dsh-context-alert",
  "version": "0.2.0",
  "private": true,
  "description": "上下文压力提醒：读取官方 contextPressure 投影，在会话该换的时候于回合结束主动提醒你开新会话。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "icon.svg",
  "files": [
    "index.js",
    "watch.js",
    "client.js",
    "alert.ps1",
    "cordis.patch.yml",
    "locale",
    "tools",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "context",
    "compaction",
    "alert"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}
